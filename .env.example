# Copy to .env.local. Never commit populated credentials.
DATABASE_URL=postgresql://planner:planner_local_only@localhost:5432/planner
APP_URL=http://localhost:3000
# Optional direct/session-pool connection for migrations only.
DIRECT_DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PLANNER_AI_API_KEY=
PLANNER_AI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SEARCH_BASE_URL=http://127.0.0.1:8080
# Generated by npm run setup:local; internal SearXNG signing secret.
SEARXNG_SECRET=
# Required by the separately hosted search gateway; generate a random key.
SEARCH_API_KEY=
SEARCH_HOSTNAME=
# Optional dated quotes. Test data is rejected in production.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=production
# Set to 1 with a running Inngest dev server for local development.
INNGEST_DEV=0
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Open-Meteo's free endpoint is for eligible non-commercial use only.
WEATHER_API_KEY=
WEATHER_COMMERCIAL=false
OPERATOR_NAME=
SUPPORT_EMAIL=
